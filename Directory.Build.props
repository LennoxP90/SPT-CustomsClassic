<Project>
  <PropertyGroup>
    <ModVersion>1.1.0</ModVersion>
    <ModGuid>com.lennoxp90.customsclassic</ModGuid>
    <ModName>CustomsClassic</ModName>
    <PluginFolder>LennoxP90-CustomsClassic</PluginFolder>
    <SptRoot Condition="'$(SptRoot)' == ''">F:\Games\SPT-4.1\SPT-4.1-Clean</SptRoot>
    <SptManaged>$(SptRoot)\EscapeFromTarkov_Data\Managed</SptManaged>
    <SptBepInEx>$(SptRoot)\BepInEx</SptBepInEx>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <DistRoot>$(MSBuildThisFileDirectory)dist\$(Configuration)\</DistRoot>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
